        <mxCell id="TAGS" value="&lt;b&gt;TAGS (관심사 15종)&lt;/b&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;PK  TAG_ID&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;TAG&lt;/div&gt;" style="shape=table;startSize=26;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;rounded=0;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="250" height="90" as="geometry"/></mxCell>
