        <mxCell id="LS" value="&lt;b&gt;LEARNING_SESSION (세션)&lt;/b&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;PK  ID&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;FK  USER_ID (→ APP_USER)&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;THEME / TYPE / SESSION_NAME&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;STATUS (IN_PROGRESS · COMPLETED ·&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;COMPLETED_NO_TALK)&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;AQ + 피드백 6컬럼&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;REPORT_VIEWED_AT&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;CREATED_AT / UPDATED_AT&lt;/div&gt;" style="shape=table;startSize=26;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="700" y="500" width="250" height="160" as="geometry"/></mxCell>
