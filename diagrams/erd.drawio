        <mxCell id="APP_USER" value="&lt;b&gt;APP_USER (계정)&lt;/b&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;PK  ID (NUMBER 19, IDENTITY)&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;UUID (UNIQUE)&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;FIREBASE_UID (UNIQUE)&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;EMAIL (UNIQUE)&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;SOCIAL_PROVIDER / SOCIAL_ID&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;CREATED_AT / UPDATED_AT&lt;/div&gt;" style="shape=table;startSize=26;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="USER_PROFILE" value="&lt;b&gt;USER_PROFILE (프로필)&lt;/b&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;PK  ID&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;FK  USER_ID (UNIQUE → APP_USER)&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;NICKNAME / SEX / BIRTH_DATE&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;HOBBIES / USER_MEMORY (CLOB)&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;PROFILE_IMAGE_BUCKET_PATH&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;font-size:10.5px;margin:1px 0 1px 6px;&quot;&gt;CREATED_AT / UPDATED_AT&lt;/div&gt;" style="shape=table;startSize=26;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;container=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="260" height="130" as="geometry"/></mxCell>
